# === Produção (Supabase cloud) ===
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# === Local (Supabase via Docker: `npm run db:start` na raiz) ===
# Emulador Android: use 10.0.2.2 (alias do host dentro do emulador)
# EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:55321
# Celular físico na mesma rede: use o IP da sua máquina
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:55321
# Anon key local: rode `npm run db:status` na raiz e copie o valor de "anon key"
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key do supabase status>
